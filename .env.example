# `pnpm setup` copies this file to apps/web/.dev.vars for local development.
# Never commit the resulting .dev.vars file.

# ─── Public deployment configuration ─────────────────────
MAIL_DOMAIN=example.com
APP_NAME=cmail
APP_URL=http://localhost:5173
ORG_NAME=Example Organisation
ORG_SHORT_NAME=Example Org
ORG_URL=https://example.com
SYSTEM_EMAIL=noreply@example.com
SYSTEM_FROM_NAME=Example Org Mail
SUPPORT_EMAIL=support@example.com
LANDING_URL=https://example.com
POLICY_URL=http://localhost:5173/policy
REPO_URL=https://github.com/Rob142857/cmail
BRAND_LOGO_URL=/logo.svg
BRAND_ICON_URL=/icon.svg
BRAND_ICON_192_URL=/icon-192.png
BRAND_ICON_512_URL=/icon-512.png
BRAND_OG_IMAGE_URL=/og-image.svg
BRAND_PRIMARY_COLOR=#0078d4
LOCALE=en
TIME_ZONE=UTC

# Safety limits (optional; defaults shown)
MAX_RECIPIENTS_PER_MESSAGE=50
OUTBOUND_RATE_LIMIT_PER_HOUR=60
# Weighted recipient/payload/R2-write units per user per hour
OUTBOUND_WORK_LIMIT_PER_HOUR=600
DRAFT_SAVE_RATE_PER_HOUR=300
MAX_DRAFTS_PER_MAILBOX_USER=100
SESSION_TTL_HOURS=8
MAX_SESSIONS_PER_USER=5

# Inbound email Worker protection (non-secret settings; defaults shown)
INBOUND_MAILBOX_MESSAGES_PER_HOUR=120
INBOUND_MAILBOX_BYTES_PER_HOUR=104857600
INBOUND_SENDER_MESSAGES_PER_HOUR=30
MAX_INBOUND_DECODED_BODY_BYTES=524288
# Shared by inbound, Sent/internal copies, and drafts.
MAILBOX_STORAGE_QUOTA_BYTES=1073741824
# INBOUND_SENDER_HASH_KEY is a separate Worker-only secret. `pnpm setup`
# creates apps/email-worker/.dev.vars from its committed blank template.

# ─── PWA new-mail notifications (optional) ───────────────
# Generate one pair with: pnpm push:keys
# Use this same pair for the Pages app and inbound email Worker.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A monitored HTTPS URL or mailto address identifying the operator.
VAPID_SUBJECT=
# Optional comma-separated additions to the built-in push-service host list.
PUSH_ENDPOINT_HOSTS=

# ─── Auth: Google OAuth (optional — enable Google SSO) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth: Microsoft Entra ID / Microsoft accounts (optional) ─
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" supports Microsoft 365 plus Outlook/Hotmail/Live when the app
# registration allows organisational and personal Microsoft accounts.
# Use your tenant GUID for a single-tenant Entra deployment.
MICROSOFT_TENANT_ID=common

# ─── Outbound delivery (optional) ─────────────────────────
# Cloudflare is the recommended committed default. Set none for an intentionally
# non-sending local/preview environment, postmark for the alternative, or auto
# to select the first complete provider: Cloudflare then Postmark. Explicit
# selection fails closed when configuration is incomplete.
OUTBOUND_PROVIDER=cloudflare

# Option 1: Cloudflare Email Service. Production uses the private EMAIL_SERVICE
# binding configured in Wrangler and needs no outbound API token. These values
# enable the REST fallback for local or non-service-binding environments only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# Option 2: Postmark
POSTMARK_API_KEY=

# ─── Session ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Bootstrap (first-run admin) ──────────────────────────
# Both values are required. Open /bootstrap, enter the strong token, then sign
# in as this exact provider-asserted email. Delete BOTH values immediately
# after the first manager is enrolled. Never commit production values.
BOOTSTRAP_ADMIN_EMAIL=
# Generate with the SESSION_SECRET command above (use a distinct value).
BOOTSTRAP_ADMIN_TOKEN=
