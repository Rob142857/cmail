#:schema node_modules/wrangler/config-schema.json
# ─── cmail inbound email worker — Cloudflare Workers config ───────────────
# Copy this file to `wrangler.toml` and fill in YOUR Cloudflare tenant values.
# `wrangler.toml` is gitignored so your IDs never leak to forks/clones.

name = "cmail-email-worker"
main = "src/index.ts"
workers_dev = false
preview_urls = false
routes = []
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]

# D1 binding — must match the database_id used by the web app.
[[d1_databases]]
binding = "DB"
database_name = "cmail-db"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

# R2 binding — same bucket as the web app.
[[r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage"

# Native, local-to-a-Cloudflare-colo inbound abuse signals. They run before D1
# but do not reject: Email Workers setReject() is permanent SMTP failure, not
# a retryable throttle. Change every namespace_id to a unique positive integer
# in your Cloudflare account, and never reuse one across environments.
[[ratelimits]]
name = "INBOUND_ACTOR_RATE_LIMITER"
namespace_id = "1001001" # placeholder: replace for your account
simple.limit = 120
simple.period = 60

[[ratelimits]]
name = "INBOUND_GLOBAL_RATE_LIMITER"
namespace_id = "1001002" # placeholder: replace for your account
simple.limit = 1000
simple.period = 60

# This third binding rate-limits the generic alert itself, not delivery.
[[ratelimits]]
name = "INBOUND_ABUSE_ALERT_RATE_LIMITER"
namespace_id = "1001003" # placeholder: replace for your account
simple.limit = 1
simple.period = 60

# Native Cloudflare Email Service sending. Pages reaches this Worker through
# the private EMAIL_SERVICE service binding; no outbound API token is required.
[[send_email]]
name = "EMAIL"

[vars]
# authserv-id of the trusted boundary MTA that stamps Authentication-Results on
# inbound mail. Inbound SPF/DKIM/DMARC verdicts are recorded only when the
# topmost record carries this identifier (RFC 8601 section 5). Leave blank and
# nothing is recorded, because an unattributed result is sender-controlled.
INBOUND_AUTHSERV_ID = ""
# 10 MiB default; code hard-caps this setting at 25 MiB.
MAX_INBOUND_BYTES = "10485760"
MAX_ATTACHMENTS_PER_MESSAGE = "25"
MAX_INBOUND_DECODED_BODY_BYTES = "524288"
# Atomic rolling-hour and retained-storage guardrails. Exact zero disables an
# individual guard; invalid values fall back to the documented safe default.
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"
# Sender limiting also requires the Worker-only INBOUND_SENDER_HASH_KEY secret.
# Generate 32 random bytes and store the unpadded base64url value with:
#   wrangler secret put INBOUND_SENDER_HASH_KEY --config apps/email-worker/wrangler.toml
# Destructive retention remains off until the operator reviews the D1
# retention_config rows and explicitly changes this value to "true".
RETENTION_JOBS_ENABLED = "false"

# Spam score at or above which inbound mail is filed to Spam instead of the
# Inbox. Higher = fewer messages quarantined; blank or non-numeric = off.
# Cloudflare Email Routing reports a score on X-CF-SpamH-Score but does not
# document its scale, so leave this blank at first: every score is still
# recorded in mail_trace regardless. Watch real traffic in Management → Mail
# trace, then set a threshold you have actually seen separate spam from
# legitimate mail. The organisation-wide sender allow/block list applies
# either way — see docs/spam-and-quarantine.md.
SPAM_QUARANTINE_SCORE = ""

# Optional PWA new-mail notifications. Match the Pages VAPID configuration.
# Store VAPID_PRIVATE_KEY with `wrangler secret put`, never in this file.
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
APP_NAME = "cmail"
PUSH_ENDPOINT_HOSTS = ""

[triggers]
crons = ["17 3 * * *"]

# Email Routing — configure a catch-all in the Cloudflare dashboard
# pointing all inbound mail at this worker.

# Isolated, non-sending target for Pages preview deployments. It deliberately
# has no native send_email binding. Configure preview Email Routing only when
# using a separate test domain; never route production mail here.
[env.preview]
name = "cmail-email-worker-preview"
workers_dev = false
preview_urls = false
routes = []
send_email = []

[[env.preview.d1_databases]]
binding = "DB"
database_name = "cmail-db-preview"
database_id = "YOUR_PREVIEW_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

[[env.preview.r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage-preview"

# Preview deliberately has independent limiter namespaces: otherwise preview
# traffic could consume production counters (or the reverse).
[[env.preview.ratelimits]]
name = "INBOUND_ACTOR_RATE_LIMITER"
namespace_id = "1001004" # placeholder: replace for your account
simple.limit = 120
simple.period = 60

[[env.preview.ratelimits]]
name = "INBOUND_GLOBAL_RATE_LIMITER"
namespace_id = "1001005" # placeholder: replace for your account
simple.limit = 1000
simple.period = 60

[[env.preview.ratelimits]]
name = "INBOUND_ABUSE_ALERT_RATE_LIMITER"
namespace_id = "1001006" # placeholder: replace for your account
simple.limit = 1
simple.period = 60

[env.preview.vars]
MAX_INBOUND_BYTES = "10485760"
MAX_INBOUND_DECODED_BODY_BYTES = "524288"
MAX_ATTACHMENTS_PER_MESSAGE = "25"
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
APP_NAME = "cmail preview"
PUSH_ENDPOINT_HOSTS = ""
RETENTION_JOBS_ENABLED = "false"
