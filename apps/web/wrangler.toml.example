#:schema node_modules/wrangler/config-schema.json
# ─── cmail web app — Cloudflare Pages config ──────────────────────────────
# Copy this file to `wrangler.toml` and fill in YOUR Cloudflare tenant values.
# `wrangler.toml` is gitignored so your IDs never leak to forks/clones.

name = "cmail-web"
compatibility_date = "2026-08-01"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = ".svelte-kit/cloudflare"

# D1 binding — run `pnpm d1:create` then paste the returned database_id here.
[[d1_databases]]
binding = "DB"
database_name = "cmail-db"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

# R2 binding — run `pnpm r2:create` first.
[[r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage"

# Private outbound path. Deploy cmail-email-worker first; it owns the native
# Email Service send binding and is not exposed on workers.dev.
[[services]]
binding = "EMAIL_SERVICE"
service = "cmail-email-worker"

# Public, non-secret variables. Override per environment as needed.
# Anything sensitive (OAuth secrets, SESSION_SECRET, outbound API tokens, etc.)
# MUST go via `wrangler pages secret put <NAME>` — never commit them here.
[vars]
APP_NAME = "cmail"
MAIL_DOMAIN = "example.com"
APP_URL = "https://mail.example.com"
# Use "common" for Microsoft 365 plus personal Microsoft accounts, or replace
# with a tenant GUID for a single-tenant Entra deployment.
MICROSOFT_TENANT_ID = "common"

# Organisation branding
ORG_NAME = "Your Organisation"
ORG_SHORT_NAME = "Your Org"
ORG_URL = "https://example.com"
SUPPORT_EMAIL = "desk@example.com"
LANDING_URL = "https://cmail.example.com"
POLICY_URL = "https://mail.example.com/policy"
REPO_URL = "https://github.com/Rob142857/cmail"
SYSTEM_EMAIL = "noreply@example.com"
SYSTEM_FROM_NAME = "Your Org Mail"
BRAND_LOGO_URL = "/logo.svg"
BRAND_ICON_URL = "/icon.svg"
BRAND_ICON_192_URL = "/icon-192.png"
BRAND_ICON_512_URL = "/icon-512.png"
BRAND_OG_IMAGE_URL = "/og-image.svg"
BRAND_PRIMARY_COLOR = "#0078d4"
LOCALE = "en"
TIME_ZONE = "UTC"
OUTBOUND_PROVIDER = "cloudflare"
# Optional REST fallback for local/non-service-binding environments. Production
# Cloudflare deployments should use EMAIL_SERVICE above and leave these blank.
CLOUDFLARE_ACCOUNT_ID = ""
MAX_RECIPIENTS_PER_MESSAGE = "50"
OUTBOUND_RATE_LIMIT_PER_HOUR = "60"
OUTBOUND_WORK_LIMIT_PER_HOUR = "600"
DRAFT_SAVE_RATE_PER_HOUR = "300"
MAX_DRAFTS_PER_MAILBOX_USER = "100"
# Inactivity window, not a fixed sign-in length: a session's expiry slides
# forward while it keeps being used, and only lapses after this many hours
# with no activity at all. Sign-out, pause, and offboarding still end a
# session immediately regardless of this value. 8 is a cautious default;
# 720 (30 days) suits most organisations that want "stay signed in" behavior
# on installed/PWA devices. Accepted range is 1-9600 (400 days, matching the
# session cookie's own fixed Max-Age).
SESSION_TTL_HOURS = "8"
MAX_SESSIONS_PER_USER = "5"

# Invitation-scoped email one-time-code sign-in, for invitees hosted by
# neither Google nor Microsoft. See docs/configuration.md. Set to "false" to
# disable it entirely (the landing-page link and /auth/email both disappear).
EMAIL_OTP_ENABLED = "true"
# Optional Cloudflare Turnstile bot check on the code-request form. Both this
# public site key and the matching TURNSTILE_SECRET_KEY (a Pages secret —
# never put it here) must be set for the widget to appear; leave both blank
# to skip it. All production tenants of this app already have both configured.
TURNSTILE_SITE_KEY = ""
# Sign-in countries (across Google, Microsoft, and this email code method
# alike) are managed in-app, not here: Management > Settings > Sign-in
# security. Off by default. See docs/travel-approvals.md.
# Hard cap on an email-OTP session's lifetime in hours, regardless of
# SESSION_TTL_HOURS — an OTP identity carries none of an OAuth account's
# ongoing 2FA/revocation guarantees. Default 168 (7 days); range 1-9600.
OTP_SESSION_TTL_HOURS = "168"

# Inbound-only limits are mirrored here for one visible deployment manifest;
# enforcement and INBOUND_SENDER_HASH_KEY belong only to the email Worker.
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
# Shared retained-message quota used by inbound, Sent/internal copies, and drafts.
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"

# Optional PWA new-mail notifications. Generate one VAPID key pair and use the
# same public key, private secret, and subject on Pages and the email Worker.
# Store VAPID_PRIVATE_KEY with `wrangler pages secret put`, never in this file.
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
# Comma-separated additions to the built-in browser push-service host list.
PUSH_ENDPOINT_HOSTS = ""

# SESSION_SECRET is mandatory at runtime. OAuth and optional outbound-provider
# secrets, including the REST-fallback CLOUDFLARE_EMAIL_API_TOKEN and
# POSTMARK_API_KEY, are optional groups, so keep sensitive values in Pages secrets or the
# ignored local .dev.vars rather than declaring an incomplete required list.
# First-run bootstrap additionally requires BOOTSTRAP_ADMIN_EMAIL and a strong,
# distinct BOOTSTRAP_ADMIN_TOKEN. Set both as Pages secrets, complete /bootstrap,
# then delete both secrets immediately.

# Preview deployments must never inherit production mail, storage, or sending.
# Create isolated preview resources, deploy the email Worker's preview
# environment, and set preview OAuth/session/bootstrap secrets separately in
# the Pages dashboard. OUTBOUND_PROVIDER remains disabled here by design.
[[env.preview.d1_databases]]
binding = "DB"
database_name = "cmail-db-preview"
database_id = "YOUR_PREVIEW_D1_DATABASE_ID"
migrations_dir = "../../packages/shared/migrations"

[[env.preview.r2_buckets]]
binding = "STORAGE"
bucket_name = "cmail-storage-preview"

[[env.preview.services]]
binding = "EMAIL_SERVICE"
service = "cmail-email-worker-preview"

[env.preview.vars]
APP_NAME = "cmail preview"
MAIL_DOMAIN = "preview.example.com"
APP_URL = "https://preview.example.pages.dev"
MICROSOFT_TENANT_ID = "common"
ORG_NAME = "Your Organisation (preview)"
ORG_SHORT_NAME = "Your Org Preview"
ORG_URL = "https://example.com"
SUPPORT_EMAIL = "desk@example.com"
LANDING_URL = "https://preview.example.pages.dev"
POLICY_URL = "https://preview.example.pages.dev/policy"
REPO_URL = "https://github.com/Rob142857/cmail"
SYSTEM_EMAIL = "noreply@preview.example.com"
SYSTEM_FROM_NAME = "Your Org Mail Preview"
BRAND_LOGO_URL = "/logo.svg"
BRAND_ICON_URL = "/icon.svg"
BRAND_ICON_192_URL = "/icon-192.png"
BRAND_ICON_512_URL = "/icon-512.png"
BRAND_OG_IMAGE_URL = "/og-image.svg"
BRAND_PRIMARY_COLOR = "#2563eb"
LOCALE = "en"
TIME_ZONE = "UTC"
OUTBOUND_PROVIDER = "none"
CLOUDFLARE_ACCOUNT_ID = ""
MAX_RECIPIENTS_PER_MESSAGE = "50"
OUTBOUND_RATE_LIMIT_PER_HOUR = "60"
OUTBOUND_WORK_LIMIT_PER_HOUR = "600"
DRAFT_SAVE_RATE_PER_HOUR = "300"
MAX_DRAFTS_PER_MAILBOX_USER = "100"
# Inactivity window — see the SESSION_TTL_HOURS comment in [vars] above.
SESSION_TTL_HOURS = "8"
MAX_SESSIONS_PER_USER = "5"
# Email-OTP sign-in — see the comments in [vars] above. Codes simply won't
# send while OUTBOUND_PROVIDER is "none" here, by the same preview design.
EMAIL_OTP_ENABLED = "true"
TURNSTILE_SITE_KEY = ""
OTP_SESSION_TTL_HOURS = "168"
INBOUND_MAILBOX_MESSAGES_PER_HOUR = "120"
INBOUND_MAILBOX_BYTES_PER_HOUR = "104857600"
INBOUND_SENDER_MESSAGES_PER_HOUR = "30"
MAILBOX_STORAGE_QUOTA_BYTES = "1073741824"
VAPID_PUBLIC_KEY = ""
VAPID_SUBJECT = ""
PUSH_ENDPOINT_HOSTS = ""
