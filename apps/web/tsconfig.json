{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "checkJs": false,
    "sourceMap": true,
    "strict": true,
    "types": [
      "$app/types",
      "@cloudflare/workers-types"
    ],
    "paths": {
      "#lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
