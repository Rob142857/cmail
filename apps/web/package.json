{
  "name": "@cmail/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/hast": "3.0.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@cmail/shared": "workspace:*",
    "@tiptap/core": "3.32.3",
    "@tiptap/extension-text-align": "3.32.3",
    "@tiptap/extension-text-style": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "mimetext": "^3.0.28",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "unified": "11.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
